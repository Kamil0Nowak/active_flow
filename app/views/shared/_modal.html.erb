<dialog id="turbo-confirm" class="modal modal-middle">
  <form method="dialog" class="modal-box">
    <h3 class="font-bold text-lg">Potwierdzenie</h3>
    <p id="turbo-confirm-message" class="py-4 text-base-content/70">Czy na pewno?</p>

    <div class="modal-action">
      <button value="cancel" class="btn btn-ghost">Anuluj</button>
      <button value="confirm" class="btn btn-error">Potwierdzam</button>
    </div>
  </form>

  <form method="dialog" class="modal-backdrop">
    <button value="cancel">close</button>
  </form>
</dialog>