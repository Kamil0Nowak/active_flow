<% if object.errors.any? %>
  <div id="error_explanation">
    <h2 class="text-xs font-light"><%= pluralize(object.errors.count, "error") %> prohibited this <%= object.class.name.downcase %> from being saved:</h2>

    <ul class="p-2 bg-red-400 border border-red-500 rounded">
      <% object.errors.full_messages.each do |message| %>
        <li class="text-black"><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>