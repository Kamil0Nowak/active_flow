<h1 class="text-2xl">Moje kursy</h1>
<div class="max-w-7xl mx-auto">
  <div class="card">
    <% @courses.each do |course| %>
      <h2> <%= course.title %> </h2>
      <ul>
        <% course.lessons.each do |lesson| %>
        <li> <%= lesson.title %> </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>