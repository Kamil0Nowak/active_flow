<h1 class="text-4xl my-6">Moje kursy</h1>

<div class="max-w-7xl mx-auto">
  <div class="card space-y-4">
      <% @courses.each do |course| %>
        <h2 class="font-semibold text-2xl"> <%= course.title %> </h2>
        <ul class="card-body bg-base-200">
          <% course.lessons.each do |lesson| %>
          <li class="grid grid-cols-2 gap-4 space-y-4">
            <p><%= lesson.title %></p>
            <% if current_user.enrolled_in_lesson?(lesson) %>
              <%= link_to "Zapisany", course_path(course), class:"text-green-300 text-sm hover:underline" %>
              <% else %>
            <%= link_to "Zapisz się", course_path(course), class:"text-red-300 text-sm hover:underline"  %>
            <% end %>
          </li>
          <% end %>
        </ul>
      <% end %>
  </div>
</div>