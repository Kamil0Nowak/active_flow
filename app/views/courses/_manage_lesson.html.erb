<tr id="enrollment-<%= enrollment.id %>">
  <td><%= enrollment.user.email %></td>
  <td>
    <span class="badge-<%= enrollment.status == 'pending' ? 'warning' : enrollment.status == 'confirmed' ? 'success' : 'error' %> hidden md:block">
      <%= enrollment.status.humanize %>
    </span>
  </td>
  <td class="flex flex-wrap gap-2">
    <% if enrollment.pending? %>
      <%= button_to "Potwierdź uczestnictwo",
                    course_lesson_enrollment_path(@course, lesson, enrollment, status: :confirmed),
                    method: :patch,
                    class: "btn btn-success btn-xs" %>
      <%= button_to "Nieobecny",
                    course_lesson_enrollment_path(@course, lesson, enrollment, status: :rejected),
                    method: :patch,
                    class: "btn btn-error btn-xs" %>
    <% end %>
  </td>
</tr>