<%= turbo_frame_tag "course_List" do %>
  <div class="min-h-[calc(100vh-200px)] flex flex-col justify-between">
      <div>
        <h1 class="text-4xl my-6 font-semibold">Nasze kursy</h1>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <%= render @courses %>
        </div>
      </div>
      <%= paginate @courses %>
  </div>
<% end %>
