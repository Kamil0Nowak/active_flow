<%= turbo_frame_tag "course_List" do %>
  <div class="min-h-[calc(100vh-200px)] flex flex-col justify-between">
      <div class="flex flex-col">
        <%= search_form_for @q, url: courses_path, method: :get, class: "w-1/2 mx-auto my-6" do |f| %>
          <div class="join w-full">
            <%= f.search_field :title_cont, placeholder: "Szukaj po tytule", class: "input input-bordered join-item w-full" %>
            <%= f.submit "Szukaj", class: "btn btn-primary join-item" %>
          </div>
        <% end %>
          <h1 class="text-4xl my-6 font-semibold">Nasze kursy</h1>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <%= render @courses %>
          </div>
        </div>
        <%= paginate @courses %>
  </div>
<% end %>
