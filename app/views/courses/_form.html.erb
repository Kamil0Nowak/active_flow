<%= form_with(model: course, class: "flex flex-col space-y-6") do |f| %>
  <%= render "shared/errors", object: course %>
  <%= f.text_field :title, class: "input input-primary w-full", placeholder: "Course title" %>

  <%= f.text_area :description, class: "textarea textarea-primary w-full", placeholder: "Course description" %>

  <%= f.label :start_date, "Start date" %>
  <%= f.date_field :start_date, class: "input input-primary w-full", placeholder: "Start date" %>

  <%= f.label :end_date, "End date" %>
  <%= f.date_field :end_date, class: "input input-primary w-full", placeholder: "End date" %>

  <%= f.number_field :capacity, class: "input input-primary w-full", placeholder: "Capacity" %>
  <%= f.submit class: "btn btn-primary" %>
  <%= link_to "Cancel", courses_path, class: "btn btn-secondary" %>
<% end %>