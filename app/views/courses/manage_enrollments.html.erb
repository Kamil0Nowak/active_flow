<h1 class="text-2xl font-bold my-8">Zarządzanie zapisami: <%= @course.title %></h1>

<div class="grid grid-cols-1 gap-4 my-8">
  <% @lessons.each do |lesson| %>
    <div class="card bg-base-200 shadow-md">
      <div class="card-body">
        <h3 class="card-title"><%= lesson.title %></h3>
        <p><%= lesson.description %></p>

        <% if lesson.enrollments.present? %>
          <table class="table w-full">
            <thead>
            <tr>
              <th>Uczeń</th>
              <th>Status</th>
              <th>Akcje</th>
            </tr>
            </thead>
            <tbody>
            <% lesson.enrollments.each do |enrollment| %>
             <%= render "manage_lesson", enrollment: enrollment, lesson: lesson %>
            <% end %>
            </tbody>
          </table>
        <% else %>
          <p class="text-gray-500">Brak zapisów na tę lekcję.</p>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<%= link_to "Powrót do kursu", course_path(@course), class: "btn btn-outline" %>