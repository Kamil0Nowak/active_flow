<%= link_to "Dodaj lekcję",
            new_course_lesson_path(@course),
            class: "btn btn-primary mt-3",
            data: { turbo_frame: "new_lesson" } if policy(@course).new?%>

<div class="card bg-base-200 p-8 mt-8 mx-auto">
  <h1 class="text-4xl font-semibold card-title"><%= @course.title %></h1>
  <div class="card-body">
    <p><span class="font-semibold"> Opis: </span> <%= @course.description %></p>
    <p><span class="font-semibold"> Ilość miejsc: </span> <%= @course.capacity %></p>
    <p><span class="font-semibold"> Nauczyciel: </span> <%= @course.teacher.full_name %></p>
    <p><span class="font-semibold"> Kurs w dniach: </span> <%= @course.start_date %> &bull; <%= @course.end_date %></p>
  </div>
  <div class="join self-center">
    <%= link_to "Edytuj", edit_course_path(@course), class: "btn btn-primary" if policy(@course).edit?%>
    <%= link_to "Wróć do listy", courses_path, class: "btn btn-secondary" %>
    <%= button_to "Usuń",
                  course_path(@course),
                  method: :delete, data: { turbo_confirm: "Are you sure?" },
                  class: "btn btn-warning" if policy(@course).destroy?%>
  </div>
  <turbo-frame id="new_lesson">
  </turbo-frame>
</div>

<div class="card bg-base-200 p-8 my-8 w-3/5">
    <% if @course.lessons.empty? %>
      <p class="text-center text-2xl">Brak lekcji</p>
    <% else %>
      <h2 class="text-2xl font-semibold">Lekcje</h2>
      <ul class="list rounded-box shadow-lg max-w-lg bg-base-300 my-3 spacing-y-2 max-h-96 overflow-y-scroll">
        <% @course.lessons.each do |lesson| %>
          <li class="list-row items-center w-full flex flex-col">
            <div class="flex items-center justify-between w-full">
              <div class="flex items-center gap-3">
                <p><%= lesson.title %></p>
                <small>
                  <%= lesson.description %>
                </small>
              </div>
              <div class="flex gap-3">
                <%= button_to "Zapisz się", '#', class: "btn btn-primary" if current_user.student? %>
                <%= button_to "Usuń",
                              course_lesson_path(@course, lesson),
                              method: :delete,
                              data: { turbo_confirm: "Are you sure?" },
                              class: "btn btn-secondary" if policy(lesson).destroy? %>
                <%= link_to "Edytuj",
                            edit_course_lesson_path(@course, lesson),
                            data: { turbo_frame: "new_lesson" },
                            class: "btn btn-primary" if policy(lesson).edit? %>
              </div>
            </div>
            <p class="p-4">Godzina: <%= lesson.start_time.strftime("%H:%M") %> : <%= lesson.end_time.strftime("%H:%M") %></p>
          </li>
      <% end %>
    </ul>
  <% end %>


</div>
