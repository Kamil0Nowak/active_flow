<div class="max-w-xl mx-auto my-6 space-y-6">
  <h2 class="text-2xl font-semibold">Sign up</h2>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="field mb-3">
      <p><%= f.label :email %></p>
      <p><%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input input-primary w-full" %></p>
    </div>

    <div class="field mb-3">
      <p><%= f.label :first_name %></p>
      <p><%= f.text_field :first_name, autofocus: true, autocomplete: "first_name", class: "input input-primary w-full" %></p>
    </div>

    <div class="field mb-3">
      <p><%= f.label :last_name %></p>
      <p><%= f.text_field :last_name, autofocus: true, autocomplete: "last_name", class: "input input-primary w-full" %></p>
    </div>

    <div class="field mb-3">
      <p><%= f.label :password %></p>
      <% if @minimum_password_length %>
        <p><em>(<%= @minimum_password_length %> characters minimum)</em></p>
      <% end %>
      <p><%= f.password_field :password, autocomplete: "new-password", class: "input input-primary w-full" %></p>
    </div>

    <div class="field mb-3">
      <p><%= f.label :password_confirmation %></p>
      <p><%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input input-primary w-full" %></p>
    </div>

    <div class="actions">
      <%= f.submit "Sign up", class: "btn btn-primary w-full"%>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>

</div>
