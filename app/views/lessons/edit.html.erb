<%= turbo_frame_tag "new_lesson" do %>
  <h1 class="text-2xl font-semibold">Edytuj <%= @lesson.title %></h1>
  <%= form_with model: [@course, @lesson], class: "mt-3 space-y-3" do |f| %>
    <%= render "shared/errors", object: @lesson %>
    <%= f.text_field :title, class: "input input-primary w-full", placeholder: "Temat lekcji"%>
    <%= f.text_area :description, class: "textarea textarea-primary w-full", placeholder: "Opis lekcji"%>
    <%= f.datetime_field :start_time, class: "input input-primary w-full" %>
    <%= f.datetime_field :end_time, class: "input input-primary w-full" %>
    <%= f.submit class: "btn btn-primary" %>
  <% end %>
<% end %>